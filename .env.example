# Lucy AI — Docker Compose config. Copy to .env and fill in.  NEVER commit .env.

# --- Required ---
# Signs cookies and verification tokens. Generate a long random value:
#   openssl rand -hex 32
COOKIE_SECRET=
# Shared secret between the app and the DB bridge. Generate another random value.
DB_TOKEN=

# --- Server ---
APP_PORT=8787
BASE_URL=http://localhost:8787
# Set true in production (HTTPS) so cookies are marked Secure.
COOKIE_SECURE=false
# AIOS room live (backend-driven) mode. true when the backend serves the site.
AIOS_LIVE=true
WELCOME_URL=http://localhost:8787/welcome.html
SIGNUP_URL=http://localhost:8787/signup.html

# --- OAuth (optional; blank = SSO buttons show "not connected") ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (optional; none | graph | gmail) ---
EMAIL_PROVIDER=none
# graph -> info@jabbnetworks.com ; gmail -> jabbnetworks@gmail.com
EMAIL_FROM=
EMAIL_FROM_NAME=Lucy AI
EMAIL_GRAPH_CLIENT_ID=
EMAIL_GRAPH_CLIENT_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
