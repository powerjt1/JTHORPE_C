# ---- Lucy AI auth backend — copy to .env and fill in. NEVER commit .env. ----

# Server
PORT=8787
# Public base URL of THIS backend (used to build the OAuth redirect URI).
BASE_URL=http://localhost:8787
# The exact redirect URI you register with BOTH providers.
# Defaults to ${BASE_URL}/auth/callback if left blank.
REDIRECT_URI=

# Where to send users after a successful sign-in, and on error.
WELCOME_URL=http://localhost:8000/welcome.html
SIGNUP_URL=http://localhost:8000/signup.html

# Secret used to sign short-lived cookies (state/PKCE) and the session cookie.
# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Set true in production (requires HTTPS) so cookies are marked Secure.
COOKIE_SECURE=false

# Optional: allow the static site origin to link here (CORS not needed for
# top-level redirects, but set if you call the backend via fetch).
ALLOWED_ORIGIN=http://localhost:8000

# ---- Microsoft (Entra ID / Azure AD) ----
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# common | organizations | consumers | <tenant-guid>
MS_TENANT=common
MS_SCOPES=openid profile email User.Read

# ---- Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCOPES=openid profile email
