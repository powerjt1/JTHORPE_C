# ---- Lucy AI auth backend — copy to .env and fill in. NEVER commit .env. ----

# Server
PORT=8787
# Public base URL of THIS backend (used to build the OAuth redirect URI).
BASE_URL=http://localhost:8787
# The exact redirect URI you register with BOTH providers.
# Defaults to ${BASE_URL}/auth/callback if left blank.
REDIRECT_URI=

# Where to send users after a successful sign-in, and on error.
WELCOME_URL=http://localhost:8000/welcome.html
SIGNUP_URL=http://localhost:8000/signup.html

# Secret used to sign short-lived cookies (state/PKCE) and the session cookie.
# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=

# Set true in production (requires HTTPS) so cookies are marked Secure.
COOKIE_SECURE=false

# Secret for signing email-verification tokens (defaults to COOKIE_SECRET).
TOKEN_SECRET=
# How long a confirmation link stays valid, in minutes (default 1440 = 24h).
VERIFY_TTL_MINUTES=1440
# Where /auth/verify sends users after success (defaults to WELCOME_URL).
VERIFIED_URL=

# Optional: allow the static site origin to link here (CORS not needed for
# top-level redirects, but set if you call the backend via fetch).
ALLOWED_ORIGIN=http://localhost:8000

# ---- Account store ----
# "memory" (default, resets on restart) or "remote" (Python SQLite bridge in db/).
ACCOUNTS_STORE=memory
# Base URL of the Python DB bridge (see db/app.py) when ACCOUNTS_STORE=remote.
DB_BRIDGE_URL=http://localhost:8799
# Shared secret sent as X-DB-Token to the bridge (must match the bridge's DB_TOKEN).
DB_TOKEN=

# ---- Microsoft (Entra ID / Azure AD) ----
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# common | organizations | consumers | <tenant-guid>
MS_TENANT=common
MS_SCOPES=openid profile email User.Read

# ---- Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCOPES=openid profile email

# ---- Outbound email (trial welcome/confirmation) ----
# Transport: none | graph (Outlook/Microsoft 365) | gmail
EMAIL_PROVIDER=none
EMAIL_FROM_NAME=Lucy AI

# If EMAIL_PROVIDER=graph  -> send as a Microsoft 365 mailbox:
#   EMAIL_FROM=info@jabbnetworks.com
# If EMAIL_PROVIDER=gmail  -> send as a Gmail mailbox:
#   EMAIL_FROM=jabbnetworks@gmail.com
EMAIL_FROM=info@jabbnetworks.com

# Microsoft Graph (Outlook) app-only sender. Needs an Entra app with the
# APPLICATION permission Mail.Send (admin-consented). Falls back to MS_* if blank.
EMAIL_GRAPH_TENANT=
EMAIL_GRAPH_CLIENT_ID=
EMAIL_GRAPH_CLIENT_SECRET=

# Gmail API sender. Needs an OAuth client + a refresh token for EMAIL_FROM
# with the gmail.send scope. Falls back to GOOGLE_* client id/secret if blank.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---- Live agent replies (Anthropic model) ----
# When set, POST /agents/:id/ask answers with a real model in the agent's role.
# Left blank -> the deterministic grounded reply is used (app still works).
# Server-side only; the key is never sent to the browser. NEVER commit it.
ANTHROPIC_API_KEY=
# Model id — set to whatever your account supports (default: claude-sonnet-4-5).
ANTHROPIC_MODEL=
# Optional: point at a gateway/proxy instead of api.anthropic.com.
ANTHROPIC_BASE_URL=
