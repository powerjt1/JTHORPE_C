{
  "mcpServers": {
    "livekit": {
      "command": "npx",
      "args": [
        "@livekit/mcp-server"
      ],
      "env": {
        "LIVEKIT_URL": "${LIVEKIT_URL}",
        "LIVEKIT_API_KEY": "${LIVEKIT_API_KEY}",
        "LIVEKIT_API_SECRET": "${LIVEKIT_API_SECRET}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@anthropic-ai/playwright-mcp"
      ],
      "env": {
        "PLAYWRIGHT_HEADLESS": "true",
        "PLAYWRIGHT_BROWSER_TYPE": "chromium"
      }
    }
  }
}
